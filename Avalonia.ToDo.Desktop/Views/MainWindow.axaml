<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Avalonia.ToDo.Desktop.ViewModels"
        xmlns:views="clr-namespace:Avalonia.ToDo.Desktop.Views"
        x:Class="Avalonia.ToDo.Desktop.Views.MainWindow"
        Title="Avalonia ToDo Desktop Application"
        x:DataType="vm:MainWindowViewModel">

    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" /> <!-- Right log panel -->
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <Border Background="White"
                CornerRadius="10"
                Margin="10"
                Padding="10"
                BoxShadow="5 5 10 0 DarkGray"
                Grid.Column="0">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>

        <!-- Live Logs Panel -->
        <Border Margin="10"
                CornerRadius="10"
                BoxShadow="5 5 10 0 DarkGray"
                Background="White"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <views:LogPanelView />
        </Border>

        <!-- Alert Box (unchanged) -->
        <Border x:Name="BottomAlert"
                Background="#FFEBEE"
                BorderBrush="#F44336"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                MinWidth="500"
                MaxWidth="900"
                IsVisible="False"
                Grid.ColumnSpan="2" Grid.Column="0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.6"
                                      Easing="CircularEaseOut" />
                    <ThicknessTransition Property="Margin"
                                         Duration="0:0:0.6"
                                         Easing="CircularEaseOut" />
                </Transitions>
            </Border.Transitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AlertMessage"
                           Text="Error message goes here"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Content="✖"
                        Width="30"
                        Height="30"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Padding="2,2"
                        Click="CloseAlert_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>