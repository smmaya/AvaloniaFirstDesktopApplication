<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:vm="clr-namespace:Avalonia.ToDo.Desktop.ViewModels"
             xmlns:ia="using:Avalonia.Xaml.Interactivity"
             xmlns:ic="using:Avalonia.Xaml.Interactions.Core"
             x:Class="Avalonia.ToDo.Desktop.Views.ToDoListView"
             x:DataType="vm:ToDoListViewModel">

    <StackPanel Margin="20" Spacing="20">

        <!-- Title -->
        <TextBlock Text="Simple ToDo with Avalonia Desktop"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <!-- Buttons -->
        <Grid ColumnDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="➕ New" Command="{Binding CreateCommand}" Width="150" Margin="0,0,10,0"
                        IsVisible="{Binding CanCreate}"/>
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Width="150"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="50">
                <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}" FontWeight="Bold"/>
                <TextBlock Text="{Binding RemainingCount, StringFormat='Remaining: {0}'}" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border Background="White" CornerRadius="8" BoxShadow="3 3 10 0 Gray">
            <StackPanel>
                <!-- Headers -->
                <Grid ColumnDefinitions="*,*,2*,Auto,Auto,Auto,Auto" Background="#E0E0E0" Height="32">
                    <TextBlock Text="Created" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="8,0" Grid.Column="0" />
                    <TextBlock Text="Title" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="8,0" Grid.Column="1" />
                    <TextBlock Text="Description" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="8,0" Grid.Column="2" />
                    <TextBlock Text="Done" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="8,0" Grid.Column="3" />
                    <TextBlock Text="View" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="5,0" Grid.Column="4" />
                    <TextBlock Text="Edit" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="5,0" Grid.Column="5" />
                    <TextBlock Text="Delete" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="5,0" Grid.Column="6" />
                </Grid>
                <!-- Data rows -->
                <ItemsControl ItemsSource="{Binding ToDos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" 
                                    BorderThickness="0,0,0,1" 
                                    Background="White" 
                                    Cursor="Hand"
                                    Focusable="True">

                                <ia:Interaction.Behaviors>
                                    <ic:EventTriggerBehavior EventName="DoubleTapped">
                                        <ic:InvokeCommandAction
                                            Command="{Binding DataContext.RowDoubleTappedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    </ic:EventTriggerBehavior>
                                </ia:Interaction.Behaviors>
                                
                                <Grid ColumnDefinitions="*,*,2*,Auto,Auto,Auto,Auto" MinHeight="32">
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MMM-dd}'}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="8,0" Grid.Column="0" />
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="8,0" Grid.Column="1" />
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="8,0" Grid.Column="2" />
                                    <CheckBox IsChecked="{Binding IsCompleted}"
                                              IsEnabled="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,0" Grid.Column="3"
                                              IsVisible="{Binding IsNotPlaceholder}" />
                                    <Button Classes="view"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="4"
                                            Width="34" Height="30"
                                            Margin="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <controls:PathIcon 
                                            Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 13a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11zm0-9a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z" 
                                            Width="16" Height="16"
                                            Foreground="DarkSlateGray"
                                            Opacity="0.8"/>
                                    </Button>
                                    <Button Classes="edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="5"
                                            Width="34" Height="30"
                                            Margin="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <controls:PathIcon 
                                            Data="M3 17.25V21h3.75l11-11-3.75-3.75-11 11zm14.81-11.81c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                            Width="16" 
                                            Height="16"
                                            Foreground="DarkSlateGray"
                                            Opacity="0.8"/>
                                    </Button>
                                    <Button Classes="delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Grid.Column="6"
                                            Width="34" Height="30"
                                            Margin="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <controls:PathIcon 
                                            Data="M6 19c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V7H6v12zm3.5-9h1v7h-1v-7zm5 0h1v7h-1v-7zM15.5 4l-1-1h-5l-1 1H5v2h14V4h-3.5z" 
                                            Width="16" 
                                            Height="16"
                                            Foreground="DarkSlateGray"
                                            Opacity="0.8"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </Border>
    </StackPanel>

</UserControl>